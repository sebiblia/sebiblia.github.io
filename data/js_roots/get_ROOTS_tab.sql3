
.mode table --charlimit -1
.mode list
.headers off
.separator "|" "\n"

CREATE TABLE IF NOT EXISTS roots (
	cid1 INT NOT NULL,
	num INT NOT NULL,
	cid2 INT NOT NULL
);

.import ROOTS.table roots

create table roo as select cid1, GROUP_CONCAT(cid2, ' ') as dat
	from roots
	group by cid1
;

.output roots_ref.tab
select * from roo;
.output
